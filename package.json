{
  "name": "dsh-aosp",
  "version": "0.1.2",
  "description": "在 DSH 里直接拉 AOSP 源码快照并在本机用 ripgrep 搜代码：走 codeload tar 快照（github.com 不通也能用），无需 root、无需 git、不编译",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib/",
    "cordis.patch.yml",
    "icon.svg",
    "locale/",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "aosp",
    "android",
    "ripgrep",
    "source"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "capabilities": [
      "tools:register",
      "network:egress",
      "subprocess",
      "fs:write"
    ],
    "labels": []
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Verchiel666/dsh-aosp.git"
  },
  "homepage": "https://github.com/Verchiel666/dsh-aosp#readme",
  "author": "Verchiel666"
}
